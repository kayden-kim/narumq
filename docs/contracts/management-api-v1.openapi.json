{
  "openapi": "3.1.2",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "NaruMQ Management API",
    "version": "1.1.0",
    "description": "Query, observability, and authenticated cluster-membership management contract. OIDC/JWT claim semantics, rate limiting, audit and dashboard APIs are deferred."
  },
  "servers": [
    {
      "url": "https://narumq.example.invalid",
      "description": "Deployment-specific management endpoint."
    }
  ],
  "security": [
    { "BearerAuth": [] },
    { "ApiKeyAuth": [] }
  ],
  "tags": [
    { "name": "Health" },
    { "name": "Cluster" },
    { "name": "ClusterMembership" },
    { "name": "Nodes" },
    { "name": "Tenants" },
    { "name": "Clients" },
    { "name": "Subscriptions" },
    { "name": "Retained" },
    { "name": "Metrics" }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "tags": ["Health"],
        "operationId": "getLiveness",
        "summary": "Read liveness status",
        "description": "Anonymous access is controlled by the listener probe policy.",
        "security": [],
        "responses": {
          "200": { "$ref": "#/components/responses/HealthResponse" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": ["Health"],
        "operationId": "getReadiness",
        "summary": "Read readiness status",
        "description": "Anonymous access is controlled by the listener probe policy.",
        "security": [],
        "responses": {
          "200": { "$ref": "#/components/responses/HealthResponse" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/health/startup": {
      "get": {
        "tags": ["Health"],
        "operationId": "getStartup",
        "summary": "Read startup status",
        "description": "Anonymous access is controlled by the listener probe policy.",
        "security": [],
        "responses": {
          "200": { "$ref": "#/components/responses/HealthResponse" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/health/drain": {
      "get": {
        "tags": ["Health"],
        "operationId": "getDrainCompletion",
        "summary": "Read drain completion status",
        "description": "Anonymous access is controlled by the listener probe policy.",
        "security": [],
        "responses": {
          "200": { "$ref": "#/components/responses/HealthResponse" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": ["Metrics"],
        "operationId": "getMetrics",
        "summary": "Scrape broker metrics",
        "description": "Returns Prometheus text by default and OpenMetrics text when requested. Anonymous access is controlled by listener policy.",
        "responses": {
          "200": { "$ref": "#/components/responses/MetricsResponse" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" }
        }
      }
    },
    "/api/v1/cluster": {
      "get": {
        "tags": ["Cluster"],
        "operationId": "getCluster",
        "summary": "Read cluster summary",
        "responses": {
          "200": { "$ref": "#/components/responses/ClusterResponse" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" }
        }
      }
    },
    "/api/v1/cluster/members": {
      "post": {
        "tags": ["ClusterMembership"],
        "operationId": "stageClusterMember",
        "summary": "Stage a new cluster member",
        "description": "Requires ClusterAdmin. Strict JSON rejects unknown, duplicate, or trailing fields. Returns only after the STAGED record commits; 202 means the committed operation is still progressing.",
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/MemberAdmissionRequest" } }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/MembershipOperationResponse" },
          "202": { "$ref": "#/components/responses/MembershipOperationResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "409": {
            "description": "Identity, idempotency key, or membership operation conflict.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "422": {
            "description": "Cluster protocol, release, or state schema is unsupported.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "500": {
            "description": "Redacted unexpected application or storage error.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "503": {
            "description": "No fresh quorum barrier or committed stage is available.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/v1/cluster/members/{memberId}": {
      "delete": {
        "tags": ["ClusterMembership"],
        "operationId": "removeClusterMember",
        "summary": "Start planned member removal",
        "description": "Requires ClusterAdmin. Starts a REMOVING membership operation and marks the member as LEAVING; the voter is not removed until ownership/checkpoint transfer and the removal configuration commit.",
        "parameters": [
          { "$ref": "#/components/parameters/MemberId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/MembershipOperationResponse" },
          "202": { "$ref": "#/components/responses/MembershipOperationResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "409": {
            "description": "Identity, idempotency key, or membership operation conflict.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "500": {
            "description": "Redacted unexpected application or storage error.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "503": {
            "description": "No fresh quorum barrier or committed operation is available.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/v1/cluster/membership-operations/{operationId}": {
      "get": {
        "tags": ["ClusterMembership"],
        "operationId": "getMembershipOperation",
        "summary": "Read committed membership operation status",
        "description": "Requires ReadOnly. Returns the last locally observed committed phase; a leader is not required.",
        "parameters": [
          { "$ref": "#/components/parameters/OperationId" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/MembershipOperationResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "500": {
            "description": "Redacted unexpected application or storage error.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/v1/nodes": {
      "get": {
        "tags": ["Nodes"],
        "operationId": "listNodes",
        "summary": "List cluster nodes",
        "parameters": [
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "example": "READY",
            "schema": { "$ref": "#/components/schemas/NodeState" }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/NodeListResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" }
        }
      }
    },
    "/api/v1/nodes/{nodeId}": {
      "parameters": [{ "$ref": "#/components/parameters/NodeId" }],
      "get": {
        "tags": ["Nodes"],
        "operationId": "getNode",
        "summary": "Read one node",
        "responses": {
          "200": { "$ref": "#/components/responses/NodeResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" }
        }
      }
    },
    "/api/v1/clients": {
      "get": {
        "tags": ["Clients"],
        "operationId": "listClients",
        "summary": "List client sessions",
        "parameters": [
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" },
          {
            "name": "tenantId",
            "in": "query",
            "required": false,
            "example": "default",
            "schema": { "$ref": "#/components/schemas/OpaqueId" }
          },
          {
            "name": "clientIdPrefix",
            "in": "query",
            "required": false,
            "example": "device-",
            "schema": { "type": "string", "minLength": 1, "maxLength": 256 }
          },
          {
            "name": "nodeId",
            "in": "query",
            "required": false,
            "example": "node-1",
            "schema": { "$ref": "#/components/schemas/OpaqueId" }
          },
          {
            "name": "protocol",
            "in": "query",
            "required": false,
            "example": "MQTT_5_0",
            "schema": { "$ref": "#/components/schemas/MqttProtocol" }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/ClientListResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" }
        }
      }
    },
    "/api/v1/clients/{tenantId}/{clientId}": {
      "parameters": [
        { "$ref": "#/components/parameters/TenantId" },
        { "$ref": "#/components/parameters/ClientId" }
      ],
      "get": {
        "tags": ["Clients"],
        "operationId": "getClientSession",
        "summary": "Read one client session",
        "responses": {
          "200": { "$ref": "#/components/responses/ClientResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" }
        }
      }
    },
    "/api/v1/subscriptions": {
      "get": {
        "tags": ["Subscriptions"],
        "operationId": "listSubscriptions",
        "summary": "List active subscriptions",
        "parameters": [
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" },
          {
            "name": "tenantId",
            "in": "query",
            "required": true,
            "example": "default",
            "schema": { "$ref": "#/components/schemas/OpaqueId" }
          },
          {
            "name": "clientId",
            "in": "query",
            "required": false,
            "example": "device-1",
            "schema": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/SubscriptionListResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" }
        }
      }
    },
    "/api/v1/retained": {
      "get": {
        "tags": ["Retained"],
        "operationId": "listRetainedMessages",
        "summary": "List retained message metadata",
        "parameters": [
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" },
          {
            "name": "tenantId",
            "in": "query",
            "required": true,
            "example": "default",
            "schema": { "$ref": "#/components/schemas/OpaqueId" }
          },
          {
            "name": "topicPrefix",
            "in": "query",
            "required": false,
            "example": "sensors/",
            "schema": { "type": "string", "minLength": 1, "maxLength": 65535 }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/RetainedListResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" }
        }
      }
    },
    "/api/v1/tenants": {
      "get": {
        "tags": ["Tenants"],
        "operationId": "listTenants",
        "summary": "List tenants",
        "responses": {
          "200": { "$ref": "#/components/responses/TenantListResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" }
        },
        "parameters": [
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Configured opaque Bearer token. OIDC and JWT claim semantics are not part of Phase 1."
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Configured opaque API key."
      }
    },
    "headers": {
      "XRequestId": {
        "description": "Opaque request correlation identifier.",
        "schema": { "type": "string", "minLength": 1, "maxLength": 128 },
        "example": "req_example"
      }
    },
    "parameters": {
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "example": "Y3VyOjUw",
        "schema": { "type": "string", "minLength": 1, "maxLength": 4096 }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "Page size. Defaults to 50 and cannot exceed 1000.",
        "example": 50,
        "schema": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 50 }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Printable ASCII 0x21 through 0x7e, 1 to 128 bytes; spaces are not allowed.",
        "schema": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[!-~]{1,128}$" }
      },
      "MemberId": {
        "name": "memberId",
        "in": "path",
        "required": true,
        "description": "Canonical positive decimal uint64.",
        "schema": { "type": "string", "minLength": 1, "maxLength": 20, "pattern": "^[1-9][0-9]*$" }
      },
      "OperationId": {
        "name": "operationId",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/CanonicalOperationId" }
      },
      "NodeId": {
        "name": "nodeId",
        "in": "path",
        "required": true,
        "example": "node-1",
        "schema": { "$ref": "#/components/schemas/OpaqueId" }
      },
      "TenantId": {
        "name": "tenantId",
        "in": "path",
        "required": true,
        "example": "default",
        "schema": { "$ref": "#/components/schemas/OpaqueId" }
      },
      "ClientId": {
        "name": "clientId",
        "in": "path",
        "required": true,
        "example": "device-1",
        "schema": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "responses": {
      "HealthResponse": {
        "description": "Health probe succeeded.",
        "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" } },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/HealthEnvelope" },
            "examples": {
              "success": {
                "value": {
                  "data": {
                    "status": "UP",
                    "reason": null,
                    "observedAt": "2026-09-20T00:00:00Z"
                  }
                }
              }
            }
          }
        }
      },
      "ClusterResponse": {
        "description": "Cluster summary.",
        "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" } },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ClusterEnvelope" },
            "examples": {
              "success": {
                "value": {
                  "data": {
                    "clusterId": "cluster-1",
                    "releaseVersion": "1.0.0",
                    "memberCount": 1,
                    "quorumSize": 1,
                    "quorumAvailable": true,
                    "leaderNodeId": "node-1",
                    "nodesByState": { "joining": 0, "ready": 1, "draining": 0, "safeToStop": 0 },
                    "underReplicated": 0,
                    "connectionCount": 0,
                    "sessionCount": 0,
                    "subscriptionCount": 0
                  }
                }
              }
            }
          }
        }
      },
      "NodeListResponse": {
        "description": "Node list.",
        "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" } },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/NodeListEnvelope" },
            "examples": {
              "success": {
                "value": {
                  "data": [
                    {
                      "nodeId": "node-1",
                      "version": "1.0.0",
                      "uptimeMs": 0,
                      "state": "READY",
                      "ready": true,
                      "readinessReason": null,
                      "role": "LEADER",
                      "lastAppliedIndex": 0,
                      "connectionCount": 0,
                      "storagePressure": false
                    }
                  ],
                  "page": { "nextCursor": null, "hasMore": false }
                }
              }
            }
          }
        }
      },
      "NodeResponse": {
        "description": "Node detail.",
        "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" } },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/NodeEnvelope" },
            "examples": {
              "success": {
                "value": {
                  "data": {
                    "nodeId": "node-1",
                    "version": "1.0.0",
                    "uptimeMs": 0,
                    "state": "READY",
                    "ready": true,
                    "readinessReason": null,
                    "role": "LEADER",
                    "lastAppliedIndex": 0,
                    "connectionCount": 0,
                    "storagePressure": false
                  }
                }
              }
            }
          }
        }
      },
      "ClientListResponse": {
        "description": "Client session list.",
        "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" } },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ClientListEnvelope" },
            "examples": {
              "success": {
                "value": {
                  "data": [
                    {
                      "tenantId": "default",
                      "clientId": "device-1",
                      "nodeId": "node-1",
                      "protocol": "MQTT_5_0",
                      "connected": true,
                      "sessionPresent": true,
                      "expiryAt": null,
                      "inflightCount": 0,
                      "offlineQueueCount": 0,
                      "maskedIdentity": null
                    }
                  ],
                  "page": { "nextCursor": null, "hasMore": false }
                }
              }
            }
          }
        }
      },
      "ClientResponse": {
        "description": "Client session detail.",
        "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" } },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ClientEnvelope" },
            "examples": {
              "success": {
                "value": {
                  "data": {
                    "tenantId": "default",
                    "clientId": "device-1",
                    "nodeId": "node-1",
                    "protocol": "MQTT_5_0",
                    "connected": true,
                    "sessionPresent": true,
                    "expiryAt": null,
                    "inflightCount": 0,
                    "offlineQueueCount": 0,
                    "maskedIdentity": null
                  }
                }
              }
            }
          }
        }
      },
      "SubscriptionListResponse": {
        "description": "Subscription list.",
        "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" } },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/SubscriptionListEnvelope" },
            "examples": {
              "success": {
                "value": {
                  "data": [
                    {
                      "tenantId": "default",
                      "clientId": "device-1",
                      "topicFilter": "sensors/#",
                      "qos": 0,
                      "sharedGroup": null
                    }
                  ],
                  "page": { "nextCursor": null, "hasMore": false }
                }
              }
            }
          }
        }
      },
      "RetainedListResponse": {
        "description": "Retained message metadata list.",
        "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" } },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/RetainedListEnvelope" },
            "examples": {
              "success": {
                "value": {
                  "data": [
                    {
                      "tenantId": "default",
                      "topic": "sensors/temp",
                      "qos": 0,
                      "payloadBytes": 4,
                      "updatedAt": "2026-09-20T00:00:00Z",
                      "expiresAt": null
                    }
                  ],
                  "page": { "nextCursor": null, "hasMore": false }
                }
              }
            }
          }
        }
      },
      "TenantListResponse": {
        "description": "Tenant list.",
        "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" } },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/TenantListEnvelope" },
            "examples": {
              "success": {
                "value": {
                  "data": [
                    {
                      "tenantId": "default",
                      "displayName": "Default Tenant",
                      "status": "ACTIVE",
                      "version": 1,
                      "createdAt": "2026-09-20T00:00:00Z"
                    }
                  ],
                  "page": { "nextCursor": null, "hasMore": false }
                }
              }
            }
          }
        }
      },
      "MetricsResponse": {
        "description": "Prometheus or OpenMetrics text exposition.",
        "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" } },
        "content": {
          "text/plain; version=0.0.4; charset=utf-8": {
            "schema": { "type": "string" },
            "examples": {
              "prometheus": {
                "value": "# HELP narumq_connections_active Current number of active client connections.\n# TYPE narumq_connections_active gauge\nnarumq_connections_active 0\n"
              }
            }
          },
          "application/openmetrics-text; version=1.0.0; charset=utf-8": {
            "schema": { "type": "string" },
            "examples": {
              "openmetrics": {
                "value": "# HELP narumq_connections_active Current number of active client connections.\n# TYPE narumq_connections_active gauge\nnarumq_connections_active 0\n# EOF\n"
              }
            }
          }
        }
      },
      "BadRequest": {
        "description": "The request is invalid.",
        "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" } },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "examples": {
              "invalidRequest": {
                "value": {
                  "error": { "code": "invalid_request", "message": "invalid request", "retryable": false, "details": null },
                  "requestId": "req_example"
                }
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication is required or credentials are invalid.",
        "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "Forbidden": {
        "description": "The authenticated principal lacks the required permission.",
        "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "NotFound": {
        "description": "The requested resource does not exist or is hidden by scope.",
        "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "MembershipOperationResponse": {
        "description": "Committed membership operation state.",
        "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" } },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/MembershipOperationEnvelope" }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "The route does not support the requested method.",
        "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "Unavailable": {
        "description": "The probe is unavailable.",
        "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      }
    },
    "schemas": {
      "OpaqueId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "CanonicalOperationId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "MemberAdmissionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["memberId", "address", "dnsSan", "certificateSha256", "releaseVersion", "clusterProtocolMajor", "clusterProtocolMinor", "stateSchemaMajor", "stateSchemaMinor"],
        "properties": {
          "memberId": { "type": "integer", "minimum": 1 },
          "address": { "type": "string", "minLength": 1, "maxLength": 255 },
          "dnsSan": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9.-]+$" },
          "certificateSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "releaseVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
          "clusterProtocolMajor": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "clusterProtocolMinor": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "stateSchemaMajor": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "stateSchemaMinor": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
        }
      },
      "MembershipAction": {
        "type": "string",
        "enum": ["ADD", "REMOVE"]
      },
      "MembershipPhase": {
        "type": "string",
        "enum": ["STAGED", "LEARNER", "CATCHING_UP", "PROMOTING", "TRANSFERRING", "REMOVING", "SUCCEEDED", "ABORTED"]
      },
      "MembershipOperation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operationId", "action", "memberId", "phase", "committedIndex"],
        "properties": {
          "operationId": { "$ref": "#/components/schemas/CanonicalOperationId" },
          "action": { "$ref": "#/components/schemas/MembershipAction" },
          "memberId": { "type": "integer", "minimum": 1 },
          "phase": { "$ref": "#/components/schemas/MembershipPhase" },
          "committedIndex": { "type": "integer", "minimum": 1 }
        }
      },
      "MembershipOperationEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data"],
        "properties": { "data": { "$ref": "#/components/schemas/MembershipOperation" } }
      },
      "Timestamp": {
        "type": "string",
        "format": "date-time"
      },
      "NodeState": {
        "type": "string",
        "enum": ["JOINING", "READY", "DRAINING", "SAFE_TO_STOP"]
      },
      "MqttProtocol": {
        "type": "string",
        "enum": ["MQTT_3_1_1", "MQTT_5_0"]
      },
      "Page": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nextCursor", "hasMore"],
        "properties": {
          "nextCursor": { "type": ["string", "null"], "maxLength": 4096 },
          "hasMore": { "type": "boolean" }
        }
      },
      "ErrorBody": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "retryable", "details"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 128 },
          "message": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "retryable": { "type": "boolean" },
          "details": { "type": ["object", "null"], "additionalProperties": true }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error", "requestId"],
        "properties": {
          "error": { "$ref": "#/components/schemas/ErrorBody" },
          "requestId": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      },
      "HealthData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "reason", "observedAt"],
        "properties": {
          "status": { "type": "string", "enum": ["UP", "STARTING", "NOT_READY", "SAFE_TO_STOP", "DOWN"] },
          "reason": { "type": ["string", "null"], "maxLength": 256 },
          "observedAt": { "$ref": "#/components/schemas/Timestamp" }
        }
      },
      "HealthEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data"],
        "properties": { "data": { "$ref": "#/components/schemas/HealthData" } }
      },
      "ClusterData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clusterId", "releaseVersion", "memberCount", "quorumSize", "quorumAvailable", "leaderNodeId", "nodesByState", "underReplicated", "connectionCount", "sessionCount", "subscriptionCount"],
        "properties": {
          "clusterId": { "$ref": "#/components/schemas/OpaqueId" },
          "releaseVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
          "memberCount": { "type": "integer", "minimum": 0 },
          "quorumSize": { "type": "integer", "minimum": 1 },
          "quorumAvailable": { "type": "boolean" },
          "leaderNodeId": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
          "nodesByState": {
            "type": "object",
            "additionalProperties": false,
            "required": ["joining", "ready", "draining", "safeToStop"],
            "properties": {
              "joining": { "type": "integer", "minimum": 0 },
              "ready": { "type": "integer", "minimum": 0 },
              "draining": { "type": "integer", "minimum": 0 },
              "safeToStop": { "type": "integer", "minimum": 0 }
            }
          },
          "underReplicated": { "type": "integer", "minimum": 0 },
          "connectionCount": { "type": "integer", "minimum": 0 },
          "sessionCount": { "type": "integer", "minimum": 0 },
          "subscriptionCount": { "type": "integer", "minimum": 0 }
        }
      },
      "ClusterEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data"],
        "properties": { "data": { "$ref": "#/components/schemas/ClusterData" } }
      },
      "NodeData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodeId", "version", "uptimeMs", "state", "ready", "readinessReason", "role", "lastAppliedIndex", "connectionCount", "storagePressure"],
        "properties": {
          "nodeId": { "$ref": "#/components/schemas/OpaqueId" },
          "version": { "type": "string", "minLength": 1, "maxLength": 64 },
          "uptimeMs": { "type": "integer", "minimum": 0 },
          "state": { "$ref": "#/components/schemas/NodeState" },
          "ready": { "type": "boolean" },
          "readinessReason": { "type": ["string", "null"], "maxLength": 256 },
          "role": { "type": "string", "enum": ["LEADER", "FOLLOWER", "LEARNER"] },
          "lastAppliedIndex": { "type": "integer", "minimum": 0 },
          "connectionCount": { "type": "integer", "minimum": 0 },
          "storagePressure": { "type": "boolean" }
        }
      },
      "NodeEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data"],
        "properties": { "data": { "$ref": "#/components/schemas/NodeData" } }
      },
      "NodeListEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "page"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/NodeData" } },
          "page": { "$ref": "#/components/schemas/Page" }
        }
      },
      "ClientSession": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tenantId", "clientId", "nodeId", "protocol", "connected", "sessionPresent", "expiryAt", "inflightCount", "offlineQueueCount", "maskedIdentity"],
        "properties": {
          "tenantId": { "$ref": "#/components/schemas/OpaqueId" },
          "clientId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "nodeId": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
          "protocol": { "$ref": "#/components/schemas/MqttProtocol" },
          "connected": { "type": "boolean" },
          "sessionPresent": { "type": "boolean" },
          "expiryAt": { "type": ["string", "null"], "format": "date-time" },
          "inflightCount": { "type": "integer", "minimum": 0 },
          "offlineQueueCount": { "type": "integer", "minimum": 0 },
          "maskedIdentity": { "type": ["string", "null"], "maxLength": 256 }
        }
      },
      "ClientEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data"],
        "properties": { "data": { "$ref": "#/components/schemas/ClientSession" } }
      },
      "ClientListEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "page"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/ClientSession" } },
          "page": { "$ref": "#/components/schemas/Page" }
        }
      },
      "SubscriptionData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tenantId", "clientId", "topicFilter", "qos", "sharedGroup"],
        "properties": {
          "tenantId": { "$ref": "#/components/schemas/OpaqueId" },
          "clientId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "topicFilter": { "type": "string", "minLength": 1, "maxLength": 65535 },
          "qos": { "type": "integer", "minimum": 0, "maximum": 2 },
          "sharedGroup": { "type": ["string", "null"], "maxLength": 256 }
        }
      },
      "SubscriptionListEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "page"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/SubscriptionData" } },
          "page": { "$ref": "#/components/schemas/Page" }
        }
      },
      "RetainedData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tenantId", "topic", "qos", "payloadBytes", "updatedAt", "expiresAt"],
        "properties": {
          "tenantId": { "$ref": "#/components/schemas/OpaqueId" },
          "topic": { "type": "string", "minLength": 1, "maxLength": 65535 },
          "qos": { "type": "integer", "minimum": 0, "maximum": 2 },
          "payloadBytes": { "type": "integer", "minimum": 0 },
          "updatedAt": { "$ref": "#/components/schemas/Timestamp" },
          "expiresAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "RetainedListEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "page"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/RetainedData" } },
          "page": { "$ref": "#/components/schemas/Page" }
        }
      },
      "TenantData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tenantId", "displayName", "status", "version", "createdAt"],
        "properties": {
          "tenantId": { "$ref": "#/components/schemas/OpaqueId" },
          "displayName": { "type": ["string", "null"], "maxLength": 256 },
          "status": { "type": "string", "enum": ["ACTIVE", "SUSPENDED"] },
          "version": { "type": "integer", "minimum": 1 },
          "createdAt": { "$ref": "#/components/schemas/Timestamp" }
        }
      },
      "TenantListEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "page"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/TenantData" } },
          "page": { "$ref": "#/components/schemas/Page" }
        }
      }
    }
  }
}
